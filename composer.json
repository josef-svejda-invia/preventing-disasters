{
    "name": "invia/preventing-disasters",
    "description": "A deliberately flawed, Therac-25-inspired PHP project for the \"Preventing Disasters with PHP\" talk.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --testsuite default",
        "test:flaws": "phpunit --testsuite flaws",
        "test:coverage": "phpunit --testsuite default --coverage-text"
    }
}
